# ======================================================================
# INTELLIGENT Grid Operator Middleware V2 - Environment Configuration Template
# ======================================================================
# Copy this file to '.env' and adjust the variables to match your environment.
# E.g., cp .env.sample .env

# ----------------------------------------------------------------------
# 1. Google Cloud Platform (GCP) Configurations
# ----------------------------------------------------------------------
# Your Google Cloud Project ID
GCP_PROJECT_ID=intelligent-grid-operator

# The GCP Pub/Sub Pull Subscription Name to pull messages from
GCP_SUBSCRIPTION_NAME=grid-operator-sub-v2

# The GCP Pub/Sub Topic where audit and tracking records will be logged for BigQuery
GCP_AUDIT_LOG_TOPIC=store_data

# ----------------------------------------------------------------------
# 2. Performance and Reliability Settings
# ----------------------------------------------------------------------
# Maximum number of unacknowledged messages pulled from Pub/Sub concurrently (Backpressure Control)
FLOW_CONTROL_MAX_MESSAGES=100

# The initial acknowledgement deadline in seconds (can be auto-extended by Pub/Sub client)
ACK_DEADLINE_SECONDS=60

# ----------------------------------------------------------------------
# 3. Downstream Pilot Gateway Endpoint (HTTP POST)
# ----------------------------------------------------------------------
# Target gateway endpoint URL used for all message types:
ENDPOINT=https://api.intelligent-pilot.eu/api/v2/messages

# ----------------------------------------------------------------------
# 4. API Key Configuration
# ----------------------------------------------------------------------
# API key sent in the x-api-key header:
ENDPOINT_API_KEY=

# ----------------------------------------------------------------------
# 5. Optional Routing Metadata
# ----------------------------------------------------------------------
# The middleware sends entityId, topicName, topicOwner, topicVersion and fqcn
# as part of the downstream gateway request body.
ENTITY_ID=612
ROUTING_TOPIC_NAME_METERING=SCN-PT-01_METERING
ROUTING_TOPIC_OWNER_METERING=E-REDES
ROUTING_TOPIC_VERSION_METERING=1.0
ROUTING_FQCN_METERING=eu.energygrid.messages.Metering

# ----------------------------------------------------------------------
# 6. Runtime Mode Configuration
# ----------------------------------------------------------------------
# Enable or disable Pub/Sub message ingestion
PUBSUB_ENABLED=true
PUBLISH_AUDIT_EVENT=false
# Enable or disable the HTTP listener mode
HTTP_LISTENER_ENABLED=true
HTTP_VALIDATE_ONTOLOGY=true
HTTP_LISTENER_PORT=8080
HTTP_LISTENER_PATH=/message

# ----------------------------------------------------------------------
# 7. Logging Configuration
# ----------------------------------------------------------------------
# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# ----------------------------------------------------------------------
# 8. EWDS Ingestion (HTTP GET /api/v2/messages)
# ----------------------------------------------------------------------
# Enable polling mode that reads messages from EWDS CGW
EWDS_ENABLED=false

# Optional: expose a local GET proxy endpoint that forwards to EWDS CGW
EWDS_PROXY_ENABLED=true
EWDS_PROXY_PATH=/ewds/messages

# EWDS CGW host and endpoint path used for GET requests
EWDS_BASE_URL=https://api.intelligent-pilot.eu
EWDS_MESSAGES_PATH=/api/v2/messages

# API key used when reading from EWDS
EWDS_API_KEY=api-key-secure-v2

# Polling behavior
EWDS_POLL_INTERVAL_MS=60000
EWDS_LOOKBACK_MS=300000
EWDS_FETCH_AMOUNT=200
EWDS_REQUEST_TIMEOUT_MS=15000
EWDS_VALIDATE_FETCHED_MESSAGES=true

# Required by GET /api/v2/messages in EWDS schema
EWDS_FQCN=channel.name

# Optional: forward fetched EWDS messages through the existing router pipeline
EWDS_FORWARD_FETCHED_MESSAGES=false

# Read-only polling mode (recommended when you only want to ingest via GET):
# - EWDS_ENABLED=true
# - EWDS_VALIDATE_FETCHED_MESSAGES=false
# - EWDS_FORWARD_FETCHED_MESSAGES=false
# - PUBLISH_AUDIT_EVENT=false

# Define one topic using individual fields
EWDS_TOPIC_OWNER=E-REDES
EWDS_TOPIC_NAME=SCN-PT-01_METERING
EWDS_CLIENT_ID=grid-operator-api
# Optional: local post-fetch filtering by topic version
EWDS_TOPIC_VERSION=1.0

# Or define multiple topics as a JSON array (takes precedence over single-topic fields)
# Required keys: owner, name, clientId
# Optional keys: version, fqcn
# EWDS_TOPICS=[{"owner":"E-REDES","name":"SCN-PT-01_METERING","clientId":"grid-operator-api","version":"1.0","fqcn":"channel.name"},{"owner":"OTHER-PILOT","name":"SCN-IE-01_MARKET","clientId":"grid-operator-api","version":"1.0","fqcn":"channel.name"}]
